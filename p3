### File 3: `src/ResumeCreate/Education.js`

```
import React from "react";

// Class component to display an education row
class EdRow extends React.Component {
  render() {
    const { id, name, place, deg, grade } = this.props;

    return (
      <tr>
        <td>{id}</td>
        <td>{name}</td>
        <td>{place}</td>
        <td>{deg}</td>
        <td>{grade}</td>
      </tr>
    );
  }
}

// Class component to display the education table
class EdTable extends React.Component {
  render() {
    const edu = [
      {
        id: 1,
        name: "National Public School",
        place: "Bengaluru",
        deg: "10th",
        grade: "A+",
      },
      {
        id: 2,
        name: "Indian Institute of Science",
        place: "Bengaluru",
        deg: "Under Grad",
        grade: "9.8",
      },
    ];

    const rows = edu.map((e) => (
      <EdRow key={e.id} {...e} />
    ));

    return (
      <table>
        <thead>
          <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Place</th>
            <th>Education</th>
            <th>Grade</th>
          </tr>
        </thead>
        <tbody>{rows}</tbody>
      </table>
    );
  }
}

// Function component
function Education() {
  return (
    <section className="edu">
      <h2>Education</h2>
      <EdTable />
    </section>
  );
}

export default Education;
```

