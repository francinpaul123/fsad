const express = require('express');
const app = express();
const port = 3000;

// Middleware to parse JSON bodies
app.use(express.json());

// Our in-memory JSON data store
let books = [
  { id: 1, title: 'The Lord of the Rings', author: 'J.R.R. Tolkien', price: 25.00, quantity: 10 },
  { id: 2, title: 'Pride and Prejudice', author: 'Jane Austen', price: 15.50, quantity: 5 },
  { id: 3, title: 'To Kill a Mockingbird', author: 'Harper Lee', price: 10.00, quantity: 7 }
];

// READ all books
app.get('/books', (req, res) => {
  res.status(200).json(books);
});

// READ one book by id
app.get('/books/:id', (req, res) => {
  const book = books.find((b) => b.id === parseInt(req.params.id));
  console.log(typeof (req.params.id), " ", book);
  if (book) {
    res.status(200).json(book);
  } else {
    res.status(404).send("Book not found");
  }
});

// CREATE a book
app.post('/books', (req, res) => {
  const newBook = {
    id: books.length ? Math.max(...books.map(b => b.id)) + 1 : 1,
    title: req.body.title,
    author: req.body.author,
    price: req.body.price,
    quantity: req.body.quantity
  };
  books.push(newBook);
  res.status(201).json(newBook);
});

// UPDATE whole book (PUT)
app.put('/books/:id', (req, res) => {
  const i = books.findIndex(b => b.id === parseInt(req.params.id));
  if (i === -1) {
    return res.status(404).json({ message: 'Book not found' });
  }
  books[i] = { id: books[i].id, ...req.body };
  res.status(200).json(books[i]);
});

// UPDATE some fields (PATCH)
app.patch('/books/:id', (req, res) => {
  const bk = books.find(b => b.id === parseInt(req.params.id));
  if (!bk) {
    return res.status(404).json({ message: 'Book not found' });
  }
  Object.assign(bk, req.body);
  res.status(200).json(bk);
});

// DELETE a book
app.delete('/books/:id', (req, res) => {
  const initialLength = books.length;
  books = books.filter(book => book.id !== parseInt(req.params.id));

  if (books.length === initialLength) {
    return res.status(404).json({ message: 'Book not found' });
  }

  res.status(200).json({ message: 'Book deleted successfully' });
});

app.get('/', (req, res) => {
  res.send('Book Cart API is running. Try /books');
});

app.listen(port, () => {
  console.log(`Server is running on http://localhost:${port}`);
});
