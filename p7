// 'use company' does not work inside a script file,
// so we switch database like this instead
db = db.getSiblingDB("company");

// ------------------------------------------------------------
// SETUP: fresh employees collection
// ------------------------------------------------------------
db.employees.drop();   // clears old data so re-running never duplicates

db.employees.insertMany([
  {
    employee_id: 101,
    name: "Sonia Rao",
    department: "Engineering",
    salary: 95000,
    hire_date: new Date("2023-01-15"),
    performance_score: 4.5,
    status: "Active"
  },
  {
    employee_id: 102,
    name: "Rajesh Kumar",
    department: "HR",
    salary: 68000,
    hire_date: new Date("2024-03-22"),
    performance_score: 4.1,
    status: "Active"
  },
  {
    employee_id: 103,
    name: "Arjun Singh",
    department: "Engineering",
    salary: 120000,
    hire_date: new Date("2022-06-01"),
    performance_score: 4.8,
    status: "Active"
  },
  {
    employee_id: 104,
    name: "Priya Mehta",
    department: "Sales",
    salary: 85000,
    hire_date: new Date("2023-11-10"),
    performance_score: 4.2,
    status: "Active"
  },
  {
    employee_id: 105,
    name: "Vikram Reddy",
    department: "Sales",
    salary: 85000,
    hire_date: new Date("2024-08-01"),
    status: "On Leave"
  }
]);

print("\nTotal documents inserted: " + db.employees.countDocuments());

// ------------------------------------------------------------
// 1. COMPARISON SELECTORS
// ------------------------------------------------------------

// 1a. $gt and $lte
// Goal: salary greater than 90000 but less than or equal to 120000
// Expected: Sonia Rao, Arjun Singh
print("\n--- 1a. $gt and $lte : salary > 90000 and <= 120000 ---");
printjson(
  db.employees.find({ salary: { $gt: 90000, $lte: 120000 } }).toArray()
);

// 1b. $in
// Goal: employees in either the HR or Sales department
// Expected: Rajesh Kumar, Priya Mehta, Vikram Reddy
print("\n--- 1b. $in : department is HR or Sales ---");
printjson(
  db.employees.find({ department: { $in: ["HR", "Sales"] } }).toArray()
);

// 1c. $ne
// Goal: employees whose status is not "On Leave"
// Expected: Sonia Rao, Rajesh Kumar, Arjun Singh, Priya Mehta
print("\n--- 1c. $ne : status is not On Leave ---");
printjson(
  db.employees.find({ status: { $ne: "On Leave" } }).toArray()
);

// ------------------------------------------------------------
// 2. LOGICAL SELECTORS
// ------------------------------------------------------------

// 2a. $and (implicit)
// Goal: Engineering employees with performance_score of 4.5 or higher
// Commas between fields act as AND automatically
// Expected: Sonia Rao, Arjun Singh
print("\n--- 2a. implicit $and : Engineering and score >= 4.5 ---");
printjson(
  db.employees.find({
    department: "Engineering",
    performance_score: { $gte: 4.5 }
  }).toArray()
);

// 2b. $or
// Goal: employees in HR OR with salary greater than 100000
// Expected: Rajesh Kumar, Arjun Singh
print("\n--- 2b. $or : HR or salary > 100000 ---");
printjson(
  db.employees.find({
    $or: [
      { department: "HR" },
      { salary: { $gt: 100000 } }
    ]
  }).toArray()
);

// ------------------------------------------------------------
// 3. COMBINING SELECTORS FOR A COMPLEX QUERY
// ------------------------------------------------------------

// Goal: Active employees in Engineering or Sales hired before 2024
// Expected: Sonia Rao, Arjun Singh, Priya Mehta
print("\n--- 3. Combined : Active, Engineering/Sales, hired before 2024 ---");
printjson(
  db.employees.find({
    status: "Active",
    department: { $in: ["Engineering", "Sales"] },
    hire_date: { $lt: new Date("2024-01-01") }
  }).toArray()
);

print("\nProgram 7 finished.");
